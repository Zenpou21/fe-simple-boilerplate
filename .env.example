# Copy this file to .env, then restart `npm run dev` whenever you change it.

# Shown in the sidebar, the login page and the browser tab.
VITE_APP_NAME="Starter Kit"

# Where the Laravel API runs (starter-kit-api). `php artisan serve` uses port 8000.
# Use "localhost" here and in the browser (not 127.0.0.1): the sign-in cookie only works
# when both sites use the same host name.
VITE_API_URL=http://localhost:8000
